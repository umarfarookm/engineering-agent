# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Jira ---
# Cloud instance
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Statuses treated as "in progress" (comma-separated)
JIRA_IN_PROGRESS_STATUSES="In Progress,In Review,Code Review"
# Optional: custom field id holding acceptance criteria, e.g. customfield_10001.
# Leave unset to read them from an "Acceptance Criteria" heading in the description.
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_ORG=
# Optional: restrict search to specific repos (comma-separated owner/name)
GITHUB_REPOS=

# --- Slack ---
SLACK_BOT_TOKEN=
# Post to a channel, or leave blank and set SLACK_USER_ID to DM yourself instead.
# DM-to-self is the safer place to start.
SLACK_CHANNEL_ID=
SLACK_USER_ID=

# --- LLM ---
# Master switch for AI processing. When false, summaries are built deterministically
# from the evidence with no model involved.
AI_ENABLED=false
# ollama runs entirely on this machine: no ticket text or code leaves it.
AI_PROVIDER=ollama
AI_MODEL=llama3.2:latest
AI_BASE_URL=http://localhost:11434
# Local models on CPU are slow; a few minutes per ticket is normal.
AI_TIMEOUT_SECONDS=300
# Send code patches to the LLM (off by default; see docs/SECURITY.md)
AI_INCLUDE_DIFFS=false

# --- Database ---
DATABASE_NAME=engineering_agent
DATABASE_URL=jdbc:postgresql://localhost:5432/engineering_agent
DATABASE_USERNAME=engineering_agent
DATABASE_PASSWORD=

# --- Service ---
SERVER_PORT=8080
# 127.0.0.1 keeps the API off the network. n8n runs in Docker and reaches the host
# from outside loopback, so running the scheduled workflow requires 0.0.0.0 -- which
# the service refuses to do unless API_AUTH_TOKEN is set.
SERVER_ADDRESS=127.0.0.1
# Required once the API is reachable beyond localhost. Generate with:
#   openssl rand -hex 32
API_AUTH_TOKEN=

# --- n8n ---
# n8n reads API_AUTH_TOKEN and SLACK_USER_ID from this file via docker-compose.yml;
# there is no second copy of either to keep in sync.
N8N_TIMEZONE=Europe/Copenhagen
