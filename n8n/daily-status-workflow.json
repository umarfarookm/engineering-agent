{
  "id": "engineering-agent-daily",
  "name": "Engineering agent \u2014 daily status",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Weekday morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_BASE_URL }}/api/slack/preview",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AGENT_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 5400000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "preview",
      "name": "Build preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 60000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ticketCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-work",
      "name": "Any active tickets?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -20,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "select": "user",
        "user": {
          "__rl": true,
          "value": "={{ $env.SLACK_USER_ID }}",
          "mode": "id"
        },
        "message": "=Daily status is ready. Send it?\n\n```\n{{ $json.message }}\n```",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Send it",
            "disapproveLabel": "Skip today"
          }
        },
        "options": {
          "limitWaitTime": true,
          "limitType": "afterTimeInterval",
          "resumeAmount": 4,
          "resumeUnit": "hours"
        }
      },
      "id": "approval",
      "name": "Ask me to approve",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        200,
        -100
      ],
      "webhookId": "engineering-agent-approval"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "approved",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_BASE_URL }}/api/slack/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AGENT_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('Build preview').first().json.message }) }}",
        "options": {}
      },
      "id": "send",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        -200
      ]
    },
    {
      "parameters": {
        "operation": "post",
        "select": "user",
        "user": {
          "__rl": true,
          "value": "={{ $env.SLACK_USER_ID }}",
          "mode": "id"
        },
        "text": "=Engineering agent could not build today's status. Check the service logs.",
        "otherOptions": {}
      },
      "id": "notify-failure",
      "name": "Tell me it failed",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        200,
        160
      ]
    }
  ],
  "connections": {
    "Weekday morning": {
      "main": [
        [
          {
            "node": "Build preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build preview": {
      "main": [
        [
          {
            "node": "Any active tickets?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tell me it failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any active tickets?": {
      "main": [
        [
          {
            "node": "Ask me to approve",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Ask me to approve": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "versionId": "1",
  "tags": []
}
